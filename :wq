import xarray as xr
import numpy as np 
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib.colors as mcolors

model="MPI-ESM1-2-LR"
varn="tas"
thresh="0.99"

for m in range(50):
	if m==0:
		ACF=xr.open_dataset("attribution/autocorr/" + model + "_" + varn + "_" + thresh + "_" + str(m) + ".nc")
	else:
		x=xr.open_dataset("attribution/autocorr/" + model + "_" + varn + "_" + thresh + "_" + str(m) + ".nc")
		ACF=xr.concat((ACF,x),dim="member")

ACF=ACF.sortby("lon")

fs=6
cm=1/2.54
w1=8*cm
h1=5*cm

bounds=np.array([-1+x*0.2 for x in range(11)])
cmap=plt.get_cmap("RdBu",len(bounds)-1)
bnorm=mcolors.BoundaryNorm(boundaries=bounds,ncolors=len(bounds)-1)

plt.close()
widths=[w1]*5
heights=[h1]*3
fig=plt.figure(figsize=(sum(widths)+0.5,sum(heights)+1))
gs=fig.add_gridspec(ncols=len(widths),nrows=len(heights),width_ratios=widths,height_ratios=heights,wspace=0.5,hspace=0.5)

for l, lag in enumerate(ACF.lag.values[1:]):

	ax1 = fig.add_subplot(gs[int(l/5),l%5])
	pl1=ACF.acf.mean(dim="member")[lag,...].plot(ax=ax1,cmap=cmap,norm=bnorm,add_colorbar=False)
        ax1.set_title("Lag: " + str(lag),fontsize=fs)
        cbar=fig.colorbar(pl1,ax=ax1,orientation='horizontal',pad=0.1,fraction=0.08)
        cbar.set_label('Autocorrelation',fontsize=fs)
        cbar.ax.tick_params(labelsize=fs)
        ax1.set_yticklabels([])
        ax1.set_xticklabels([])
        ax1.set_xlabel("")
        ax1.set_ylabel("")

	plt.savefig('figs/autocor/AUTOCOR_' + varn + '_' + thresh + '_' + model + '.png',bbox_inches='tight',dpi=300)
plt.close()


